{
  "name": "@lew-ds/lds-react",
  "version": "1.0.0",
  "description": "React bindings for the Lew Design System — wraps @lew-ds/lds's framework-free templates and controllers as React components, for React-based consumers (Claude Design, Claude Code) without changing @lew-ds/lds itself.",
  "license": "MIT",
  "type": "module",
  "files": [
    "src"
  ],
  "main": "./src/index.jsx",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.jsx"
    },
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@lew-ds/lds": "^1.0.0"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "scripts": {
    "test": "node scripts/smoke-test.mjs && node scripts/browser-test.mjs"
  },
  "keywords": [
    "design-system",
    "react",
    "components",
    "lds"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/matthewlew/lds.git",
    "directory": "packages/lds-react"
  },
  "publishConfig": {
    "access": "public"
  }
}
