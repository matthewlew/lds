{
  "name": "@lew-ds/lds-react",
  "version": "2.0.0",
  "description": "React components for the Lew Design System: the markup of @lew-ds/lds's templates as JSX, server-rendered with every slot in the HTML. Stateless components are server components; only the five stateful ones are client components.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "types"
  ],
  "main": "./dist/index.js",
  "types": "./types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./dist/index.js"
    },
    "./icon-sprite": {
      "types": "./types/icon-sprite.d.ts",
      "default": "./dist/icon-sprite.js"
    },
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@lew-ds/lds": "^1.1.1",
    "@lew-ds/open-icons": "^1.0.0"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepack": "node scripts/build.mjs",
    "prepublishOnly": "node scripts/dependency-floor.mjs",
    "test": "node scripts/build.mjs && node scripts/parity-test.mjs && node scripts/server-test.mjs && tsc -p tsconfig.json && node scripts/browser-test.mjs"
  },
  "keywords": [
    "design-system",
    "react",
    "react-server-components",
    "components",
    "lds"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/matthewlew/lds.git",
    "directory": "packages/lds-react"
  },
  "publishConfig": {
    "access": "public"
  }
}
