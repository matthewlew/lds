{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "@lew/lds/src/components/Avatar/**",
              "@lew/lds/src/components/Banner/**",
              "@lew/lds/src/components/Button/**",
              "@lew/lds/src/components/ButtonGroup/**",
              "@lew/lds/src/components/Card/**",
              "@lew/lds/src/components/Checkbox/**",
              "@lew/lds/src/components/Chip/**",
              "@lew/lds/src/components/CodeField/**",
              "@lew/lds/src/components/EmptyState/**",
              "@lew/lds/src/components/Icon/**",
              "@lew/lds/src/components/Inline/**",
              "@lew/lds/src/components/Link/**",
              "@lew/lds/src/components/Menu/**",
              "@lew/lds/src/components/Modal/**",
              "@lew/lds/src/components/Nav/**",
              "@lew/lds/src/components/Radio/**",
              "@lew/lds/src/components/Row/**",
              "@lew/lds/src/components/SegmentedControl/**",
              "@lew/lds/src/components/Select/**",
              "@lew/lds/src/components/Skeleton/**",
              "@lew/lds/src/components/Table/**",
              "@lew/lds/src/components/Tabs/**",
              "@lew/lds/src/components/Tag/**",
              "@lew/lds/src/components/TextField/**",
              "@lew/lds/src/components/Textarea/**",
              "@lew/lds/src/components/Toast/**",
              "@lew/lds/src/components/Toggle/**",
              "@lew/lds/src/components/Tooltip/**",
              "**/components/Avatar/**",
              "**/components/Banner/**",
              "**/components/Button/**",
              "**/components/ButtonGroup/**",
              "**/components/Card/**",
              "**/components/Checkbox/**",
              "**/components/Chip/**",
              "**/components/CodeField/**",
              "**/components/EmptyState/**",
              "**/components/Icon/**",
              "**/components/Inline/**",
              "**/components/Link/**",
              "**/components/Menu/**",
              "**/components/Modal/**",
              "**/components/Nav/**",
              "**/components/Radio/**",
              "**/components/Row/**",
              "**/components/SegmentedControl/**",
              "**/components/Select/**",
              "**/components/Skeleton/**",
              "**/components/Table/**",
              "**/components/Tabs/**",
              "**/components/Tag/**",
              "**/components/TextField/**",
              "**/components/Textarea/**",
              "**/components/Toast/**",
              "**/components/Toggle/**",
              "**/components/Tooltip/**"
            ],
            "message": "Import design-system components from '@lew/lds', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\"]?(?:Coconat|Martian Mono|Ronzino))/i]",
        "message": "Font not provided by the design system. Available: Coconat, Martian Mono, Ronzino."
      },
      {
        "selector": "JSXOpeningElement[name.name='Avatar'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|src|alt|size|hue|ring|iconHref|className|key|ref|style|children)$/]",
        "message": "<Avatar> doesn't accept that prop. Declared props: name, src, alt, size, hue, ring, iconHref, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='Avatar'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:xs|sm|lg|xl|2xl)$/]",
        "message": "<Avatar> size must be one of 'xs' | 'sm' | 'lg' | 'xl' | '2xl'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Avatar'] > JSXAttribute[name.name='hue'] > Literal[value!=/^(?:red|orange|yellow|green|cyan|blue|violet|pink|gray)$/]",
        "message": "<Avatar> hue must be one of 'red' | 'orange' | 'yellow' | 'green' | 'cyan' | 'blue' | 'violet' | 'pink' | 'gray'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Banner'] > JSXAttribute > JSXIdentifier[name!=/^(?:status|emphasis|page|title|icon|iconHref|children|actions|dismissible|onDismiss|className|key|ref|style)$/]",
        "message": "<Banner> doesn't accept that prop. Declared props: status, emphasis, page, title, icon, iconHref, children, actions, dismissible, onDismiss, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='Banner'] > JSXAttribute[name.name='status'] > Literal[value!=/^(?:info|success|warning|caution|error)$/]",
        "message": "<Banner> status must be one of 'info' | 'success' | 'warning' | 'caution' | 'error'."
