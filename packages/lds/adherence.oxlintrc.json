        "message": "<Banner> emphasis must be one of 'plain' | 'subtle' | 'soft' | 'strong' | 'stark'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|iconOnly|iconStart|iconEnd|subtitle|iconHref|emphasis|hue|armed|href|fab|extended|disabled|onClick|className|children|key|ref|style)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, iconOnly, iconStart, iconEnd, subtitle, iconHref, emphasis, hue, armed, href, fab, extended, disabled, onClick, className, children."
