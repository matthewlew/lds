{
  "name": "@lew/lds",
  "version": "1.0.0",
  "description": "Lew Design System — React components over a one-token CSS architecture, with four themes and light/dark.",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "src",
    "css",
    "fonts",
    "adherence.oxlintrc.json"
  ],
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./css": "./css/styles.css",
    "./css/palette": "./css/apca-palette.css",
    "./css/lds": "./css/lds.css",
    "./css/themes/palette": "./css/themes/palette.css",
    "./css/themes/product": "./css/themes/product.css",
    "./css/themes/roadtrip": "./css/themes/roadtrip.css",
    "./fonts/*": "./fonts/*",
    "./adherence.oxlintrc.json": "./adherence.oxlintrc.json",
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@lew/open-icons": "1.0.0"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0"
  },
  "scripts": {
    "test": "node ../../scripts/render-test.mjs"
  },
  "keywords": ["design-system", "react", "components", "css", "lds"]
}
