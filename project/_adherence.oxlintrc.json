{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/Avatar/**",
              "components/Banner/**",
              "components/Button/**",
              "components/ButtonGroup/**",
              "components/Card/**",
              "components/Checkbox/**",
              "components/Chip/**",
              "components/CodeField/**",
              "components/EmptyState/**",
              "components/Icon/**",
              "components/Inline/**",
              "components/Link/**",
              "components/Menu/**",
              "components/Modal/**",
              "components/Radio/**",
              "components/Row/**",
              "components/Select/**",
              "components/Skeleton/**",
              "components/Table/**",
              "components/Tabs/**",
              "components/Tag/**",
              "components/TextField/**",
              "components/Textarea/**",
              "components/Toggle/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Ronzino|Coconat|Martian Mono))/i]",
        "message": "Font not provided by the design system. Available: Ronzino, Coconat, Martian Mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='Avatar'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|src|alt|size|hue|ring|iconHref|className|key|ref|className|style|children)$/]",
        "message": "<Avatar> doesn't accept that prop. Declared props: name, src, alt, size, hue, ring, iconHref, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='Avatar'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:xs|sm|lg|xl|2xl)$/]",
        "message": "<Avatar> size must be one of 'xs' | 'sm' | 'lg' | 'xl' | '2xl'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Avatar'] > JSXAttribute[name.name='hue'] > Literal[value!=/^(?:red|orange|yellow|green|cyan|blue|violet|pink|gray)$/]",
        "message": "<Avatar> hue must be one of 'red' | 'orange' | 'yellow' | 'green' | 'cyan' | 'blue' | 'violet' | 'pink' | 'gray'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Banner'] > JSXAttribute > JSXIdentifier[name!=/^(?:status|emphasis|page|title|icon|iconHref|children|actions|dismissible|onDismiss|className|key|ref|className|style|children)$/]",
        "message": "<Banner> doesn't accept that prop. Declared props: status, emphasis, page, title, icon, iconHref, children, actions, dismissible, onDismiss, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='Banner'] > JSXAttribute[name.name='status'] > Literal[value!=/^(?:info|success|warning|caution|error)$/]",
        "message": "<Banner> status must be one of 'info' | 'success' | 'warning' | 'caution' | 'error'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Banner'] > JSXAttribute[name.name='emphasis'] > Literal[value!=/^(?:plain|subtle|soft|strong|stark)$/]",
        "message": "<Banner> emphasis must be one of 'plain' | 'subtle' | 'soft' | 'strong' | 'stark'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|iconOnly|iconStart|iconEnd|subtitle|iconHref|emphasis|hue|armed|disabled|onClick|className|children|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, iconOnly, iconStart, iconEnd, subtitle, iconHref, emphasis, hue, armed, disabled, onClick, className, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|tertiary)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'tertiary'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='emphasis'] > Literal[value!=/^(?:plain|subtle|soft|strong|stark|media)$/]",
        "message": "<Button> emphasis must be one of 'plain' | 'subtle' | 'soft' | 'strong' | 'stark' | 'media'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='hue'] > Literal[value!=/^(?:red|orange|yellow|green|cyan|blue|violet|pink|gray)$/]",
        "message": "<Button> hue must be one of 'red' | 'orange' | 'yellow' | 'green' | 'cyan' | 'blue' | 'violet' | 'pink' | 'gray'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ButtonGroup'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|detail|detailNote|orientation|width|align|stackOnMobile|className|key|ref|className|style|children)$/]",
        "message": "<ButtonGroup> doesn't accept that prop. Declared props: children, detail, detailNote, orientation, width, align, stackOnMobile, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='ButtonGroup'] > JSXAttribute[name.name='orientation'] > Literal[value!=/^(?:horizontal|vertical)$/]",
        "message": "<ButtonGroup> orientation must be one of 'horizontal' | 'vertical'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ButtonGroup'] > JSXAttribute[name.name='width'] > Literal[value!=/^(?:hug|fill)$/]",
        "message": "<ButtonGroup> width must be one of 'hug' | 'fill'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ButtonGroup'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:start|center|end|split)$/]",
        "message": "<ButtonGroup> align must be one of 'start' | 'center' | 'end' | 'split'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute > JSXIdentifier[name!=/^(?:kicker|title|body|meta|actions|emphasis|hue|selectable|selected|disabled|onClick|className|children|key|ref|className|style|children)$/]",
        "message": "<Card> doesn't accept that prop. Declared props: kicker, title, body, meta, actions, emphasis, hue, selectable, selected, disabled, onClick, className, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute[name.name='emphasis'] > Literal[value!=/^(?:plain|subtle|soft|strong|stark)$/]",
        "message": "<Card> emphasis must be one of 'plain' | 'subtle' | 'soft' | 'strong' | 'stark'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute[name.name='hue'] > Literal[value!=/^(?:red|orange|yellow|green|cyan|blue|violet|pink|gray)$/]",
        "message": "<Card> hue must be one of 'red' | 'orange' | 'yellow' | 'green' | 'cyan' | 'blue' | 'violet' | 'pink' | 'gray'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Checkbox'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|id|checked|disabled|onChange|className|key|ref|className|style|children)$/]",
        "message": "<Checkbox> doesn't accept that prop. Declared props: label, id, checked, disabled, onChange, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='Chip'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|selected|size|icon|caret|onRemove|removeLabel|iconHref|onClick|className|key|ref|className|style|children)$/]",
        "message": "<Chip> doesn't accept that prop. Declared props: children, selected, size, icon, caret, onRemove, removeLabel, iconHref, onClick, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='Chip'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|lg)$/]",
        "message": "<Chip> size must be one of 'sm' | 'lg'."
